    def wait_for_ack(expected_cmd, timeout_reads=500):
        """Block until a hardware ACK packet for expected_cmd is received.
    
        Silently discards FIFO-empty packets (0xFFFF) while polling.
        Logs a warning on backpressure or unexpected packet types.
    
        Parameters
        ----------
        expected_cmd : int
            Command opcode whose ACK we expect (e.g. 0x04 for CMD_NTWK_PARAM_W).
        timeout_reads : int
            Maximum DMA reads before raising ACKError.
    
        Returns
        -------
        (cmd_echo, seq_num, status) : (int, int, int)
    
        Raises
        ------
        ACKError
            If no matching ACK is received within timeout_reads attempts.
        """
        if DISABLE_ACKS:
            return
        global _ack_expected_seq
        for _ in range(timeout_reads):
            exitCode, data = dmadump.dma_dump_read(1, 0, 0, 0, dmadump.DmaMethodNormal, 64)
            b63, b62 = int(data[63]), int(data[62])
            if b63 == _HDR_ACK[0] and b62 == _HDR_ACK[1]:
                cmd_echo, seq_num, status = parse_ack_packet(data)
                if cmd_echo != expected_cmd:
                    logging.warning(
                        "ACK cmd_echo mismatch: expected 0x%02X got 0x%02X (seq %d)",
                        expected_cmd, cmd_echo, seq_num,
                    )
                if status == ACK_STATUS_BACKPRESSURE:
                    logging.warning(
                        "ACK backpressure for cmd 0x%02X (seq %d) — host sending faster than TX path can drain",
                        cmd_echo, seq_num,
                    )
                _ack_expected_seq = seq_num + 1
                return cmd_echo, seq_num, status
            elif b63 == _HDR_FIFO_EMPTY[0] and b62 == _HDR_FIFO_EMPTY[1]:
                continue  # FIFO empty — keep polling
            else:
                logging.warning(
                    "Unexpected packet while waiting for ACK: bytes[63]=0x%02X, [62]=0x%02X",
                    b63, b62,
                )
