        Raises
        ------
        ACKError
            If no matching ACK is received within timeout_reads attempts.
        """
        if DISABLE_ACKS:
            return
        global _ack_expected_seq
        for _ in range(timeout_reads):
            exitCode, data = dmadump.dma_dump_read(1, 0, 0, 0, dmadump.DmaMethodNormal, 64)
